default_platform(:android)

# Fastlane's own working directory is wherever `fastlane` was invoked from (usually `android/`),
# but that's not reliable across local runs vs CI — resolve every path from this Fastfile's own
# location instead.
ANDROID_DIR = File.expand_path('..', __dir__)
PROJECT_ROOT = File.expand_path('..', ANDROID_DIR)

platform :android do

  desc "Install JS deps, regenerate the native android/ project, and build a signed release AAB"
  lane :build_android do
    # app.config.ts falls back to APP_ENV=development when unset — a Play Store build must
    # always be production, and this has to be set before prebuild *and* before the gradle
    # bundle task, since both read it (prebuild writes it into app config, Gradle's JS bundle
    # step re-reads it when Metro bundles the release JS).
    ENV['APP_ENV'] ||= 'production'
    ENV['NODE_ENV'] ||= 'production'

    Dir.chdir(PROJECT_ROOT) do
      sh("npm", "ci")
      # No --clean: android/ is checked into git with manual customizations (Firebase,
      # signing config, RNFB Podfile-equivalent Gradle tweaks) that a full wipe would discard.
      # This only syncs Expo-managed files against the current app.config.ts.
      sh("npx", "expo", "prebuild", "--platform", "android")
    end

    gradle(
      task: 'bundle',
      build_type: 'Release',
      project_dir: ANDROID_DIR,
    )
  end

  desc "Build and deploy to the Play Store internal testing track"
  lane :deploy_android do
    system('cd ..')
    system('export APP_ENV=production')
    system('export NODE_ENV=production')
    system('npx expo prebuild --platform android')    
    system('cd android')
    system('./gradlew --stop')
    system('./gradlew bundleRelease ')

    upload_to_play_store(
      track: 'internal',
      release_status: 'completed',
      metadata_path: './fastlane/metadata',
      json_key: './fastlane/pgfy-64511-96b244485dfd.json',
      aab: aab_path,
      skip_upload_apk: true,
      skip_upload_aab: false,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      track_promote_to: 'internal',
      track_promote_release_status: 'completed',
      validate_only: false,
      timeout: 300,
      changes_not_sent_for_review: false,
      rescue_changes_not_sent_for_review: true,
      in_app_update_priority: 0,
      ack_bundle_installation_warning: false,
    )
  end
end
