{
  "name": "pgfy-tenant",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "postinstall": "patch-package",
    "start": "NODE_ENV=development APP_ENV=development expo start",
    "start:staging": "NODE_ENV=development APP_ENV=staging expo start --clear",
    "start:prod": "NODE_ENV=production APP_ENV=production expo start --clear --no-dev",
    "android": "NODE_ENV=development APP_ENV=development expo run:android --device KB2001",
    "ios": "NODE_ENV=development APP_ENV=development expo run:ios",
    "web": "NODE_ENV=development APP_ENV=development expo start --web",
    "typecheck": "tsc --noEmit",
    "prebuild": "expo prebuild",
    "prebuild:android": "expo prebuild --platform android --clean",
    "build:apk:local": "bash scripts/build-android-local.sh release",
    "build:apk:local:release": "bash scripts/build-android-local.sh release",
    "build:apk:gradle:debug": "cd android && ./gradlew assembleDebug",
    "build:apk:gradle:release": "cd android && ./gradlew assembleRelease",
    "build:apk": "eas build --platform android --profile staging --non-interactive",
    "build:apk:staging": "eas build --platform android --profile staging --non-interactive",
    "build:apk:prod": "eas build --platform android --profile production --non-interactive",
    "update:staging": "APP_ENV=staging eas update --branch staging",
    "update:prod": "APP_ENV=production eas update --branch production"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-firebase/app": "^25.1.0",
    "@react-native-firebase/messaging": "^25.1.0",
    "axios": "^1.18.1",
    "expo": "~54.0.0",
    "expo-av": "~16.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-document-picker": "~14.0.8",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-router": "~6.0.24",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.18",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-view-shot": "4.0.3",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "rn-scratch-card": "^1.2.4"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.11",
    "dotenv": "^17.4.2",
    "patch-package": "^8.0.1",
    "typescript": "~5.9.2"
  }
}
