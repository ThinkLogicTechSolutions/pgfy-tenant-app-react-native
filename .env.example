# Copy to .env.development / .env.staging / .env.production and adjust per environment.
# APP_ENV selects which environment app.config.ts applies: development | staging | production.
APP_ENV=development
# Base URL of the PGfy API for this environment. Read at config time and exposed to the app
# as Constants.expoConfig.extra.apiUrl (see src/lib/config.ts).
API_URL=http://10.0.2.2:4000/api
